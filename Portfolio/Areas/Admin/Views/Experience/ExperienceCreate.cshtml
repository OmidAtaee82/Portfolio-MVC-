@{
    ViewBag.Title = "Experience Create";
}


<div class="container-84-h-auto">

    <div class="col-lg-11 d-lg-flex justify-content-lg-between align-items-lg-center" style="margin: auto;margin-top: 75px">

        <div class="text-white">
            <h3>Create New Experience</h3>
            <h5>Add a new experience to your timeline</h5>
        </div>

        <div>
            <a asp-area="Admin" asp-controller="Experience" asp-action="Experiences" class="text-decoration-none text-white rounded-2" style="padding: 10px 15px 10px 15px;border: 2px solid #222a33">
                <i class="fa fa-arrow-left me-2"></i>Back to Experience
            </a>
        </div>

    </div>

    <form method="post" action="/admin/experience/create">
        <div class="col-lg-11 shadow-lg text-white p-3 rounded-4 m-auto mt-4" style="background-color: #121824;border: 2px solid #1b202e">

            <div class="mb-3 d-lg-flex justify-content-lg-between">

                <div class="col-lg-5">
                    <label class="form-label">Expertise <span class="text-danger">*</span> </label>
                    <input type="text" name="Expertise" class="form-control" placeholder="Example : Back End Developer" />
                </div>

                <div class="col-lg-5">
                    <label class="form-label">Name Company <span class="text-danger">*</span></label>
                    <input type="text" name="NameCompany" class="form-control" placeholder="Example : Spark Code">
                </div>

            </div>

            <div class="mb-3">
                <label class="form-label">Description <span class="text-danger">*</span> </label>
                <textarea name="Description" class="form-control" rows="3" placeholder="Write about your work experiences"></textarea>
            </div>

            <div class="mb-3 d-lg-flex justify-content-lg-between">

                <div class="col-lg-5">
                    <label class="form-label">Start Date <span class="text-danger">*</span> </label>
                    <input type="date" name="StartData" class="form-control" placeholder="Example : Back End Developer" />
                </div>

                <div class="col-lg-5">
                    <label class="form-label">End Date <span class="text-danger"></span></label>
                    <input type="date" name="EndDate" class="form-control" placeholder="example : Spark Code">
                </div>

            </div>

            <input type="submit" value="Save" class="border-0 rounded-3 mt-3" style="padding: 8px 30px 8px 30px;background-color: #07db07" />

        </div>
    </form>

</div>