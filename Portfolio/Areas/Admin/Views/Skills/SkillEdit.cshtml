@model Skills

@{
    ViewBag.Title = "Skill Edit";
}


<div class="container-84-h-auto">

    <div class="col-lg-11 d-lg-flex justify-content-lg-between align-items-lg-center" style="margin: auto;margin-top: 75px">

        <div class="text-white">
            <h3>Edit Skills</h3>
            <h5>Add a new Skills to Showcase your expertise</h5>
        </div>

        <div>
            <a asp-area="admin" asp-controller="Skills" asp-action="Skills" class="text-decoration-none text-white rounded-2" style="padding: 10px 15px 10px 15px;border: 2px solid #222a33">
                <i class="fa fa-arrow-left me-2"></i>Back to Skills
            </a>
        </div>

    </div>

    <div class="col-lg-11 shadow-lg text-white p-3 rounded-4 m-auto mt-4" style="background-color: #121824;border: 2px solid #1b202e">

        <form method="post" action="" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">Name <span class="text-danger">*</span> </label>
                <input type="text" name="Name" value="@Model.Name" class="form-control" placeholder="example : Omid Ataei" />
            </div>

            <img src="@Model.Image" alt="" style="width:150px;height:150px;border-radius:10px"/>

            <div class="mb-3">
                <label class="form-label">Image <span class="text-danger">*</span> </label>
                <input type="file" name="file" value="@Model.Image" class="form-control" />
            </div>

            <input type="submit" value="Save" class="border-0 rounded-3 mt-3" style="padding: 8px 30px 8px 30px;background-color: #07db07" />
        </form>

    </div>

</div>