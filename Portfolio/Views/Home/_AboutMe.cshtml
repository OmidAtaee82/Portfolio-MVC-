@model List<AboutMe>

<div class="container-fluid" id="about" style="position: relative;z-index: 1">

    <div class="container-intro" data-aos="zoom-in-up" data-aos-duration="1600">

        <div class="row-container">

            <div class="col-lg-6 col-12 container-about">

                <div class="col-lg-9 col-12 pt-lg-0 pt-1" style="min-height: 250px">

                    <div class="col-12 fw-bold d-flex align-items-center gap-2 mt-lg-0 mt-3" style="font-size: 20px">
                        <div class="circle"></div>
                        <p class="text-white">About Me</p>
                    </div>

                    <p class="col-12 mt-3" style="color: #d8d9de">
                        Web developer with 2+ years of frontend experience, currently specializing in ASP.NET Core and full stack development. Always eager to learn and take on new challenges.
                    </p>

                    <a href="#" class="btn-ReadMore">
                        Read More
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 20px;height: 20px">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                        </svg>
                    </a>

                </div>

            </div>

            <div class="col-lg-6 col-12 d-flex gap-lg-3 gap-0 container-about">

                <div class="col-5 col-lg-3 d-flex flex-column gap-4" style="color: #d8d9de">

                    <div class="col-12 lable-about d-block d-lg-flex align-items-lg-center gap-2">
                        <svg color="#804afa" class="vector-about" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                        </svg>
                        Name :
                    </div>

                    <div class="col-12 lable-about d-block d-lg-flex align-items-lg-center gap-2">
                        <svg color="#804afa" class="vector-about" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z" />
                        </svg>
                        Email :
                    </div>

                    <div class="col-12 lable-about d-block d-lg-flex align-items-lg-center gap-2">
                        <svg color="#804afa" class="vector-about" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                        </svg>
                        Location :
                    </div>

                    <div class="col-12 lable-about d-block d-lg-flex align-items-lg-center gap-2">
                        <svg color="#804afa" class="vector-about" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25" />
                        </svg>
                        Freelancer :
                    </div>

                </div>

                <div class="col-7 col-lg-8 d-flex flex-column gap-4">
                    @foreach(var item in Model)
                    {
                        <div class="col-12 text-about" style="padding: 1px 0;color: #d8d9de">@item.Name</div>
                        <div class="col-12 text-about" style="padding: 1px 0;color: #d8d9de">@item.Email</div>
                        <div class="col-12 text-about" style="padding: 1px 0;color: #d8d9de">@item.Location</div>
                        <div class="col-12 text-about" style="padding: 1px 0;color: #d8d9de;color: limegreen">Active</div>
                    }
                </div>

            </div>

        </div>

    </div>

</div>