@model List<Skills>

<div class="container-fluid" id="skills">

    <div class="container_2" data-aos="zoom-in-up" data-aos-duration="1600">

        <div class="col-lg-12 col-12 box-title d-flex align-items-center gap-2 fw-bold">
            <div class="circle"></div>
            <p class="text-white">Skills</p>
        </div>

        <div class="col-12 col-lg-12 d-flex flex-wrap justify-content-between gap-lg-2 gap-3 m-auto mt-lg-4 ps-4 pe-4">

            @foreach(var item in Model)
            {
                <div class="box-skill">

                    <div class="col-lg-11 col-12 m-auto mt-2 d-flex justify-content-center">
                        <img src="@item.Image" alt="" class="skill-icon">
                    </div>

                    <p class="text-center mt-2" style="font-size: 17px;color: #d8d9de">@item.Name</p>

                </div>
            }

        </div>

    </div>

</div>