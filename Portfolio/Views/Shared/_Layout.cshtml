<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/style.css"/>
    <link rel="stylesheet" href="~/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/aos-master/dist/aos.css" />
</head>
<body>

    <!-- Header Desktop -->
    <div class="container-fluid d-lg-block d-none header z-3" style="border-bottom: 2px solid #21293e;background-color: #131321">

        <div class="width-header">

            <div class="col-lg-2 d-lg-flex align-items-lg-center">

                <a href="#" class="logo w-100 text-decoration-none d-lg-flex align-items-lg-center m-0" style="color: #fffeff">
                    <p class="m-0">< / > Omid<span style="color: #6a40e8">.dev</span></p>
                </a>

            </div>

            <div class="col-lg-8 d-lg-flex justify-content-lg-center gap-5 align-items-lg-center">

                <a href="index.html" class="text-decoration-none navbar">Home</a>
                <a href="#about" class="text-decoration-none navbar">About</a>
                <a href="#skills" class="text-decoration-none navbar">Skills</a>
                <a href="#projects" class="text-decoration-none navbar">Projects</a>
                <a href="#experience" class="text-decoration-none navbar">Experience</a>
                <a href="#experience" class="text-decoration-none navbar">Contact</a>

            </div>

            <div class="col-lg-2 d-lg-flex justify-content-lg-end align-items-lg-center">

                <div class="box-theme">
                    <svg color="#d7d9dd" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 35px;height: 35px">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                    </svg>

                    <!--                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">-->
                    <!--                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />-->
                    <!--                        </svg>-->

                </div>

            </div>

        </div>

    </div>


    <!-- Header Mobile -->
    <div class="container-fluid d-lg-none d-block mobile-header position-fixed top-0" style="border-bottom: 2px solid #21293e;z-index: 10;background-color: #131321">

        <div class="d-flex justify-content-between align-items-center" style="height: 100%">

            <div class="logo-mobile text-white">
                <a>< / > Omid<span style="color: #8253f1">.dev</span></a>
            </div>

            <div class="hamberger-menu">
                <svg color="white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </div>

        </div>

        <div class="mobile-sidebar d-lg-none d-none">

            <div class="theme">
                <div class="box-theme-mobile">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="width: 35px;height: 35px">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                    </svg>
                </div>
            </div>

            <!--                <div class="hr"></div>-->

            <div class="box-navbar">
                <a href="#">Home</a>
                <a href="#">About</a>
                <a href="#">Skills</a>
                <a href="#">Projects</a>
                <a href="#">Experience</a>
                <a href="#">Contact</a>
            </div>

        </div>

    </div>

    <div>
        @RenderBody()
    </div>

    <!-- footer -->
    <div class="footer">
        © 2026 , Omid Ataei , All rights reserved
    </div>

    <script src="./js/bootstrap.min.js"></script>
    <script src="aos-master/dist/aos.js"></script>
    <script>
        AOS.init();
    </script>

    <script src="typed.js-3.0.0/dist/typed.umd.js"></script>
    <script>
        new Typed('#typingText', {
            strings: [
                "Omid Ataei"
            ],
            typeSpeed: 150,
            backSpeed: 100,
            backDelay: 1500 ,
            showCursor: false
        });
    </script>

</body>
</html>
